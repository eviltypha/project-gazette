# Copy to .env and adjust. Defaults run fully offline.

# Paths
GAZETTE_CORPUS_DIR=data/circulars
GAZETTE_INDEX_DIR=index
GAZETTE_DB_PATH=gazette.sqlite3

# LLM provider: "fake" (default, deterministic, offline) or "openai"
GAZETTE_LLM_PROVIDER=fake
# Only needed when GAZETTE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedder: "hashed" (default, deterministic, offline)
GAZETTE_EMBEDDER=hashed

# Retrieval
GAZETTE_TOP_K=5

# Refusal threshold on best vector cosine similarity (chosen from eval data)
GAZETTE_MIN_SIMILARITY=0.15
