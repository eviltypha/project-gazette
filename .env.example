# Configuration is read from process environment variables (no .env auto-loading).
# Export the ones you want to override; defaults run fully offline.

# Paths
GAZETTE_CORPUS_DIR=data/circulars
GAZETTE_INDEX_DIR=index
GAZETTE_DB_PATH=gazette.sqlite3

# LLM provider: only "fake" (deterministic, extractive, offline) is implemented.
GAZETTE_LLM_PROVIDER=fake

# Embedder: only "hashed" (deterministic hashed word/char n-gram TF-IDF) is implemented.
GAZETTE_EMBEDDER=hashed

# Retrieval
GAZETTE_TOP_K=5

# Refusal threshold on best vector cosine similarity (selected by python -m gazette.eval)
GAZETTE_MIN_SIMILARITY=0.2319